---
/**
 * `/` — the landing page (CONTENT.md, DESIGN.md §6).
 * Section order: HERO → [01] why → [02] about → marquee → [03] how →
 * [04] features → [05] big assemblies → [06] nothing leaves → [07] install →
 * [08] what's next → closing CTA → footer. One component per section in
 * components/landing/.
 *
 * The page owns the figure sequence: one counter, handed to the sections in the
 * order they appear below, so captions read `FIG. 00`, `FIG. 01`, … down the
 * document (src/lib/figures.ts).
 */
import Base from '../layouts/Base.astro';
import About from '../components/landing/About.astro';
import Assemblies from '../components/landing/Assemblies.astro';
import Closing from '../components/landing/Closing.astro';
import Features from '../components/landing/Features.astro';
import Hero from '../components/landing/Hero.astro';
import How from '../components/landing/How.astro';
import InstallTeaser from '../components/landing/InstallTeaser.astro';
import MarqueeBand from '../components/landing/MarqueeBand.astro';
import Next from '../components/landing/Next.astro';
import Privacy from '../components/landing/Privacy.astro';
import SectionIndex from '../components/landing/SectionIndex.astro';
import Why from '../components/landing/Why.astro';
import { figureCounter } from '../lib/figures';

const figs = figureCounter();
---

<Base>
  <SectionIndex />
  <Hero figs={figs} />
  <Why />
  <About />
  <MarqueeBand />
  <How figs={figs} />
  <Features figs={figs} />
  <Assemblies figs={figs} />
  <Privacy />
  <InstallTeaser />
  <Next />
  <Closing />
</Base>
