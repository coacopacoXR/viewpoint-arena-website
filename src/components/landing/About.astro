---
/**
 * [02] ABOUT. Copy supplied by the author, verbatim (not in CONTENT.md).
 */
import Display from '../Display.astro';
import SectionHead from '../SectionHead.astro';
import { withBase } from '../../lib/links';

interface AboutLink {
  label: string;
  href: string;
}

const LINKS: AboutLink[] = [
  {
    label: 'Thesis:',
    href: 'https://www.diva-portal.org/smash/record.jsf?pid=diva2%3A2056563',
  },
  {
    label: 'Google Scholar:',
    href: 'https://scholar.google.com/citations?user=h2on66wAAAAJ',
  },
  {
    label: 'LinkedIn:',
    href: 'https://www.linkedin.com/in/francisco-garcía-rivera',
  },
];

/* The author's video. A local poster stands in until it is clicked, so nothing
   loads from YouTube unless the visitor asks for it; with JS off it is a plain
   link to the video. */
const VIDEO_ID = 'rhwUCv2HzrQ';
const VIDEO_URL = `https://youtu.be/${VIDEO_ID}`;
const posterSrcset = [640, 1280]
  .map((w) => `${withBase(`/assets/about-video-poster-${w}.webp`)} ${w}w`)
  .join(', ');
---

<section class="about section" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHead label="[02] ABOUT" fig="FIG. 02" />

    <div class="about__title breakout">
      <Display as="h2" id="about-title" reveal="up" lines={['About']} />
    </div>

    <p class="about__lead t-lead" data-reveal="up">
      Viewpoint Arena grew out of my doctoral research on how engineering teams review 3D
      designs together.
    </p>

    <div class="about__grid grid">
      <div class="about__body">
        <p class="about__para" data-reveal="lines">
          I'm Francisco García Rivera. I hold a PhD from the University of Skövde, where my
          thesis studied collaborative technologies for engineering design reviews: how
          people point at parts, share viewpoints, and reach decisions around a model when
          some of them have CAD seats and some don't.
        </p>

        <p class="about__para" data-reveal="lines">
          The same problems kept coming up. Reviews were slowed down by screen-sharing, by
          stakeholders who couldn't open the files, and by confidential designs that
          couldn't leave the company network. Viewpoint Arena is my attempt to put the
          findings into a tool anyone can run: a shared room in the browser, live pointing
          and comments on specific parts, and a default install that keeps everything on
          your own machine.
        </p>

        <p class="about__para" data-reveal="lines">
          I'm based in Malmö, Sweden, and build at the intersection of CAD-native 3D
          tooling, real-time collaboration, and AI-assisted review.
        </p>
      </div>

      <figure class="about__video" data-reveal="up">
        <a
          class="about__play u-nolink"
          href={VIDEO_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-yt={VIDEO_ID}
          aria-label="Play the video: Francisco introduces Viewpoint Arena (YouTube)"
        >
          <img
            src={withBase('/assets/about-video-poster-1280.webp')}
            srcset={posterSrcset}
            sizes="(min-width: 1024px) 33vw, 100vw"
            alt=""
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
          <span class="about__playbtn" aria-hidden="true">▶ Play</span>
        </a>
        <figcaption class="about__caption">
          In my own words: why I built Viewpoint Arena. Plays from YouTube.
        </figcaption>
      </figure>

      <ul class="about__links">
        {
          LINKS.map((link) => (
            <li>
              {link.label} <a href={link.href} target="_blank" rel="noopener noreferrer">{link.href}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  /* Swap the poster for the player only on click (youtube-nocookie). */
  document.querySelectorAll<HTMLAnchorElement>('[data-yt]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = 'Viewpoint Arena, introduced by Francisco García Rivera';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'about__iframe';
      link.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .about__title {
    padding-block-start: var(--sp-32);
    min-width: 0;
  }

  .about__lead {
    padding-block-start: var(--sp-32);
    color: var(--ink-2);
    max-width: var(--measure);
  }

  .about__grid {
    padding-block-start: var(--sp-48);
    align-items: start;
    row-gap: var(--sp-48);
  }

  /* §1: body copy sits beside the big type, in the same slot as .why__body */
  .about__body {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-24);
    min-width: 0;
  }

  @media (min-width: 640px) {
    .about__body {
      grid-column: 2 / span 6;
    }
  }

  .about__para {
    color: var(--ink-2);
    max-width: var(--measure);
  }

  /* the links sit under the body column, at the same width */
  .about__links {
    grid-column: 1 / -1;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .about__links {
      grid-column: 2 / span 6;
    }
  }

  /* hairline list, like a drawing's note column */
  .about__links li {
    padding-block: var(--sp-12);
    border-block-start: var(--hairline) solid var(--rule);
    color: var(--ink-2);
  }

  .about__links li:last-child {
    border-block-end: var(--hairline) solid var(--rule);
  }

  /* these URLs are long: break them rather than scroll at 360px */
  .about__links a {
    overflow-wrap: anywhere;
  }

  /* the video sits in the empty right-hand columns beside the bio on desktop,
     and between the bio and the links below that */
  .about__video {
    grid-column: 1 / -1;
    margin: 0;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .about__video {
      grid-column: 2 / span 6;
    }
  }

  @media (min-width: 1024px) {
    .about__video {
      grid-column: 9 / span 4;
      grid-row: 1 / span 2;
      position: sticky;
      top: var(--sp-112);
    }
  }

  .about__play,
  .about__video :global(.about__iframe) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: var(--hairline) solid var(--rule);
    border-radius: var(--r-box);
    overflow: hidden;
    background-color: var(--paper-2);
  }

  .about__play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .about__play:hover img {
    transform: scale(1.02);
  }

  .about__playbtn {
    position: absolute;
    inset-inline-start: var(--sp-16);
    inset-block-end: var(--sp-16);
    padding: var(--sp-8) var(--sp-16);
    border-radius: var(--r-box);
    background-color: var(--signal);
    color: var(--on-signal);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--t-mono-wght);
    letter-spacing: var(--t-mono-ls);
    text-transform: uppercase;
  }

  .about__caption {
    padding-block-start: var(--sp-12);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--t-mono-wght);
    letter-spacing: var(--t-mono-ls);
    line-height: var(--t-mono-lh);
    color: var(--ink-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .about__play img {
      transition: none;
    }
  }
</style>
