---
/**
 * [04] BIG ASSEMBLIES (CONTENT.md). §4: the counters scrub from the "before"
 * value to the "after" value; the HTML already holds the final value.
 * Every number is shown with its conditions (§8).
 */
import Display from '../Display.astro';
import Figure from '../Figure.astro';
import Limit from '../Limit.astro';
import SectionHead from '../SectionHead.astro';
import SrcTag from '../SrcTag.astro';
import Stat from '../Stat.astro';
import type { FigureCounter } from '../../lib/figures';

interface Props {
  /** The page's figure counter (src/lib/figures.ts). */
  figs?: FigureCounter;
}

const { figs } = Astro.props;
---

<section class="asm section" id="assemblies" aria-labelledby="asm-title">
  <div class="container">
    <SectionHead label="[04] BIG ASSEMBLIES" fig="FIG. 04" path="perf/results/README.md" />

    <div class="asm__title breakout">
      <Display
        as="h2"
        id="asm-title"
        reveal="up"
        lines={['Ten thousand parts.', 'Eight draw calls.']}
      />
    </div>

    <div class="asm__grid grid">
      <p class="asm__lead t-lead" style="--span: 5; --span-md: 8;" data-reveal="up">
        Every part stays its own part (selectable, pinnable, movable in a variant), but the
        renderer draws them in batches per material. Here is what that changed, measured by
        the repo's own benchmark.
      </p>

      <div class="asm__fig" style="--span: 7; --span-md: 8;">
        <Figure name="big-assembly" figs={figs} span={7} />
      </div>

      {/* 2×2 grid of huge numbers (§4 [04], task 02) */}
      <div class="asm__stats grid" style="--span: 12; --span-md: 8;">
        <div style="--span: 6; --span-md: 4;">
          <Stat
            from="10 002"
            to="8"
            label="DRAW CALLS PER FRAME, 10 000-PART ASSEMBLY"
            foot="8481b9b → f9a96f0"
          />
        </div>
        <div style="--span: 6; --span-md: 4;">
          <Stat
            from="207.7"
            to="11.4"
            unit="ms"
            label="MEDIAN FRAME WHILE ORBITING"
            foot="4.8 → 87.7 FPS · same conditions, full resolution"
          />
        </div>
        <div style="--span: 6; --span-md: 4;">
          <Stat
            from="16.0"
            to="1.2"
            unit="s"
            label="FILE PICKED TO MODEL ON SCREEN"
            foot="10 000 parts, 80 MB GLB"
          />
        </div>
        <div style="--span: 6; --span-md: 4;">
          <Stat
            to="0"
            label="FRAMES DRAWN IN 5 IDLE SECONDS"
            foot="renders on demand since e09eb99 (it was 1 974)"
          />
        </div>
      </div>

      <div class="asm__today" style="--span: 6; --span-md: 8;">
        <p class="asm__todaytext">
          On today's main the same orbit runs at a 5.8 ms median, because the room also
          drops to half resolution and hides sub-two-pixel parts while the camera moves,
          then restores both when it stops.
        </p>
        <p class="asm__todaysrc">
          <SrcTag sha="e09eb99" date="2026-10-16" />
        </p>
      </div>

      <div class="asm__cad" style="--span: 6; --span-md: 8;">
        <h3 class="asm__cadtitle t-h3">STEP, opened once</h3>
        <p class="asm__cadbody">
          An 800-part STEP assembly takes 6.5 s to open when the browser tessellates it in
          WebAssembly, and 0.03 s when the browser loads the GLB that convert-service made.
          The conversion itself took 2.7 s and produced 368 KiB, with every part in the same
          place to a tenth of a micron.
        </p>
        <p class="asm__cadsrc">
          <SrcTag path="convert-service/README.md" anchor="3" />
        </p>
      </div>

      <div class="asm__limit" style="--span: 8; --span-md: 8;">
        <Limit label="STILL WORKING ON" path="perf/results/laser.md">
          <p>
            Pointing at a 10 000-part model is slower than orbiting it: 57–105 ms median per
            frame across two runs of the laser sweep. That is the next number to beat.
          </p>
        </Limit>
      </div>

      <p class="asm__foot" style="--span: 12; --span-md: 8;">
        Measured by npm run perf: headless Chromium 153, vsync off, 1600×900, Intel
        i9-11950H, NVIDIA RTX A3000 Laptop GPU. Numbers depend on the machine; compare
        rows, not sites.
      </p>
    </div>
  </div>
</section>

<style>
  .asm__title {
    padding-block-start: var(--sp-32);
    min-width: 0;
  }

  .asm__grid {
    padding-block-start: var(--sp-48);
    align-items: start;
    row-gap: var(--sp-48);
  }

  .asm__lead {
    color: var(--ink-2);
    max-width: var(--measure);
    min-width: 0;
  }

  .asm__fig,
  .asm__stats,
  .asm__today,
  .asm__cad,
  .asm__limit {
    min-width: 0;
  }

  .asm__stats {
    row-gap: var(--sp-48);
  }

  .asm__today,
  .asm__cad {
    display: grid;
    gap: var(--sp-12);
    align-content: start;
  }

  .asm__todaytext,
  .asm__cadbody {
    margin: 0;
    color: var(--ink-2);
    max-width: var(--measure);
  }

  .asm__todaysrc,
  .asm__cadsrc {
    margin: 0;
  }

  .asm__foot {
    margin: 0;
    padding-block-start: var(--sp-16);
    border-block-start: var(--hairline) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--t-mono-wght);
    letter-spacing: var(--t-mono-ls);
    line-height: var(--t-mono-lh);
    color: var(--ink-2);
    max-width: 72ch;
  }
</style>
