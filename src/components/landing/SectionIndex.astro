---
/**
 * Quiet vertical section index at the edge of the sheet (DESIGN.md §4 "Nav",
 * kinoria reference). Desktop only; src/scripts/section-index.ts highlights
 * the section currently under the middle of the viewport.
 */
const SECTIONS = [
  { id: 'why', num: '01', label: 'Why it exists' },
  { id: 'about', num: '02', label: 'About' },
  { id: 'how', num: '03', label: 'How it works' },
  { id: 'features', num: '04', label: 'Features' },
  { id: 'privacy', num: '05', label: 'Privacy' },
  { id: 'install', num: '06', label: 'Install' },
  { id: 'next', num: '07', label: "What's next" },
] as const;
---

<nav class="sindex" aria-label="Section index">
  <ul class="sindex__list">
    {
      SECTIONS.map((section) => (
        <li>
          <a class="sindex__link u-nolink" href={`#${section.id}`} data-index-link={section.id}>
            <span class="sindex__num" aria-hidden="true">{section.num}</span>
            <span class="visually-hidden">{section.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import '../../scripts/section-index';
</script>

<style>
  .sindex {
    position: fixed;
    inset-block: 0;
    inset-inline-end: var(--sp-8);
    z-index: 90;
    display: none;
    align-items: center;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .sindex {
      display: flex;
    }
  }

  .sindex__list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sindex__link {
    display: block;
    padding: var(--sp-4);
    pointer-events: auto;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--t-mono-wght);
    letter-spacing: var(--t-mono-ls);
    line-height: var(--t-mono-lh);
    color: var(--ink-2);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .sindex__link:hover,
  .sindex__link:focus-visible {
    color: var(--signal-ink);
  }

  /* the current section reads as ink with a signal tick, like a dimension */
  .sindex__link[aria-current='true'] {
    color: var(--ink);
  }

  .sindex__link[aria-current='true'] .sindex__num {
    box-shadow: inset 0 calc(-1 * var(--hairline)) 0 0 var(--signal);
  }
</style>
