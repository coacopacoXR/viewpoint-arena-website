---
/**
 * Button (DESIGN.md §5). Two kinds only: primary = ink pill that wipes to
 * signal on hover/focus; ghost = hairline pill. Labels are mono uppercase and
 * the arrow is a separate span so it can nudge 4px (§4).
 */
import { withBase } from '../lib/links';

interface Props {
  /** Internal path (base-aware) or an absolute URL. */
  href: string;
  variant?: 'primary' | 'ghost';
  /** Arrow drawn after the label. Pass `null` for no arrow. */
  arrow?: '→' | '↗' | null;
  /** Force external link semantics (`target="_blank"` + `rel`). */
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', arrow = '→', external, class: className } = Astro.props;

const isExternal = external ?? /^(https?:)?\/\//.test(href);
---

<a
  class:list={[
    'btn',
    `btn--${variant}`,
    arrow === '↗' && 'btn--ne',
    'u-nolink',
    className,
  ]}
  href={isExternal ? href : withBase(href)}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  <span class="btn__label"><slot /></span>
  {arrow !== null && <span class="btn__arrow" aria-hidden="true">{arrow}</span>}
</a>

<style>
  .btn {
    --arrow-x: 4px;
    --arrow-y: 0px;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    padding: var(--sp-12) var(--sp-24);
    border-radius: var(--r-pill);
    border: var(--hairline) solid transparent;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--t-mono-wght);
    letter-spacing: var(--t-mono-ls);
    line-height: var(--t-mono-lh);
    text-transform: uppercase;
    text-decoration: none;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition:
      background-size var(--dur-hover) var(--ease-out),
      background-color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out),
      color var(--dur-hover) var(--ease-out);
  }

  /* §4: ink wipes from the bottom in 180ms */
  .btn--primary {
    background-color: var(--ink);
    background-image: linear-gradient(var(--signal), var(--signal));
    background-size: 100% 0%;
    color: var(--paper);
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    background-size: 100% 100%;
    color: var(--on-signal);
  }

  .btn--ghost {
    border-color: var(--rule);
    color: var(--ink);
  }

  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    border-color: var(--signal);
    color: var(--signal-ink);
    box-shadow: var(--glow);
  }

  .btn__arrow {
    display: inline-block;
    transition: transform var(--dur-hover) var(--ease-out);
  }

  /* ↗ nudges up and right, → nudges right (§4) */
  .btn--ne {
    --arrow-x: 3px;
    --arrow-y: -3px;
  }

  .btn:hover .btn__arrow,
  .btn:focus-visible .btn__arrow {
    transform: translate(var(--arrow-x), var(--arrow-y));
  }
</style>
