---
/**
 * Figure (DESIGN.md §5, §7).
 *
 * Three states, decided by the asset registry in `src/lib/assets.ts`:
 *  1. still  — `<picture>` with the webp `srcset` at every width that exists
 *              (640/1280/1920, never upscaled), `sizes` matching the columns the
 *              figure occupies, explicit intrinsic `width`/`height`, lazy and
 *              async-decoded — or eager with `fetchpriority="high"` for the hero.
 *  2. video  — mp4, `muted playsinline loop preload="none"` + poster webp; it
 *              plays only in view and never under reduced motion
 *              (src/scripts/video.ts).
 *  3. neither — a `--paper-2` mat with the mono text `ASSET PENDING · <name>`,
 *              for the slots CONTENT.md marks that have no capture.
 *
 * Captions are copy: the words come from the registry (ASSETS.md) or from the
 * caller (CONTENT.md), never composed here. Only the `FIG. nn` in front of them
 * is generated — by the page's figure counter, in document order.
 */
import {
  assetCaption,
  getAsset,
  hasAsset,
  pendingText,
  posterSrc,
  sizesFor,
  stillSrc,
  stillSrcset,
  videoSrc,
  type AssetName,
} from '../lib/assets';
import type { FigureCounter } from '../lib/figures';

interface Props {
  /** Registry name, e.g. `laser`. Unknown names render the pending mat. */
  name: string;
  /**
   * The page's figure counter (src/lib/figures.ts). Only a figure that has
   * caption copy draws a number from it, so the sequence stays gapless.
   */
  figs?: FigureCounter;
  /** Overrides the registry's alt (the hero still is described by HeroModel). */
  alt?: string;
  /** Overrides the registry caption entirely. */
  caption?: string;
  /** Explicit `sizes`; defaults to the figure's column spans. */
  sizes?: string;
  /** 12-col span at ≥1024px / 8-col span at 640–1023px. */
  span?: number;
  spanMd?: number;
  /** Hero only: load eagerly with a high fetch priority (§7). */
  eager?: boolean;
  /** A different capture to show below 640px, when the wide one crops badly. */
  mobileName?: AssetName;
  class?: string;
}

const {
  name,
  figs,
  alt,
  caption,
  sizes,
  span = 12,
  spanMd = 8,
  eager = false,
  mobileName,
  class: className,
} = Astro.props;

const asset = hasAsset(name) ? getAsset(name) : null;
const text = alt ?? asset?.alt ?? '';
/* An explicit `caption` is copy and is used verbatim. Otherwise the registry
   supplies the text after the dash and the page's counter supplies the number —
   and a figure with no caption copy spends no number, so the printed sequence
   has no gaps. */
const body = asset && hasAsset(name) ? assetCaption(name) : undefined;
const captionText =
  caption ?? (body ? (figs ? `${figs.next()} — ${body}` : body) : undefined);

const resolvedSizes = sizes ?? sizesFor(span, spanMd);
const mobileAsset =
  mobileName && hasAsset(mobileName) && getAsset(mobileName).kind === 'still'
    ? getAsset(mobileName)
    : null;
const mobileSrcset = mobileName && hasAsset(mobileName) ? stillSrcset(mobileName) : undefined;

const ratio = asset ? `${asset.width} / ${asset.height}` : '16 / 10';
const mobileRatio = mobileAsset ? `${mobileAsset.width} / ${mobileAsset.height}` : undefined;
---

<figure
  class:list={['figure', className]}
  style={`--figure-ratio: ${ratio};${mobileRatio ? ` --figure-ratio-mobile: ${mobileRatio};` : ''}`}
>
  <div class="figure__frame">
    {asset?.kind === 'still' && hasAsset(name) ? (
      <picture>
        {mobileSrcset && (
          <source media="(max-width: 639px)" type="image/webp" srcset={mobileSrcset} sizes="100vw" />
        )}
        <source
          type="image/webp"
          srcset={stillSrcset(name)}
          sizes={mobileSrcset ? `(min-width: 640px) ${resolvedSizes}` : resolvedSizes}
        />
        <img
          src={stillSrc(name)}
          alt={text}
          width={asset.width}
          height={asset.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : undefined}
          sizes={mobileSrcset ? `(min-width: 640px) ${resolvedSizes}` : resolvedSizes}
          srcset={stillSrcset(name)}
        />
      </picture>
    ) : asset?.kind === 'video' && hasAsset(name) ? (
      <div class="figure__video" role="img" aria-label={text}>
        <video
          muted
          playsinline
          loop
          preload="none"
          width={asset.width}
          height={asset.height}
          poster={posterSrc(name)}
          data-video-in-view
        >
          <source src={videoSrc(name)} type="video/mp4" />
        </video>
      </div>
    ) : (
      <div class="figure__mat" role="img" aria-label={text || pendingText(name)}>
        <span class="figure__pending">{pendingText(name)}</span>
      </div>
    )}
  </div>
  {captionText && <figcaption class="figure__caption">{captionText}</figcaption>}
</figure>

<script>
  import '../scripts/video';
</script>

<style>
  .figure {
    margin: 0;
    min-width: 0;
  }

  .figure__frame {
    aspect-ratio: var(--figure-ratio);
    background-color: var(--paper-2);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--r-box);
    overflow: hidden;
  }

  /* a mobile-only capture keeps its own ratio (the tall panel column) */
  @media (max-width: 639px) {
    .figure__frame {
      aspect-ratio: var(--figure-ratio-mobile, var(--figure-ratio));
    }
  }

  .figure__frame img,
  .figure__frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* §2: images sit on --paper-2 mats with a 1px --rule border */
  .figure__mat {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: var(--sp-16);
    background-color: var(--paper-2);
    /* faint blueprint cross, so an empty mat still reads as a drawing sheet */
    background-image:
      linear-gradient(to right, var(--grid) 0 var(--hairline), transparent var(--hairline)),
      linear-gradient(to bottom, var(--grid) 0 var(--hairline), transparent var(--hairline));
    background-position: center;
    background-size:
      33.334% 100%,
      100% 33.334%;
    background-repeat: no-repeat;
  }

  .figure__pending {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--t-mono-wght);
    letter-spacing: var(--t-mono-ls);
    line-height: var(--t-mono-lh);
    text-transform: uppercase;
    color: var(--ink-2);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .figure__caption {
    padding-block-start: var(--sp-12);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: var(--t-mono-wght);
    letter-spacing: var(--t-mono-ls);
    line-height: var(--t-mono-lh);
    /* captions are sentences, not labels: no uppercase (§5 example) */
    text-transform: none;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
</style>
